[lopi]
max_agents = 4
log_level = "info"
db_path = "~/.lopi/lopi.db"

[claude]
cli_path = "claude"
timeout_secs = 300

[git]
default_allowed_dirs = ["src/", "tests/"]
default_forbidden_dirs = [".github/", "infra/", "Cargo.toml"]
auto_pr = true

[remote.telegram]
# token = "your-bot-token"
# chat_id = 123456789
# allowed_chat_ids = [123456789]        # empty = any chat may issue commands (dev mode)
# egress_allowed_chat_ids = [123456789] # empty = no automated sends (deny by default);
#                                        # required to receive completion notifications / reports

[remote.whatsapp]
# account_sid = "ACxxxxxxxxxxxxxxx"
# auth_token = "your-token"
# from = "whatsapp:+14155238886"

[web]
port = 3000
host = "127.0.0.1"
# Auth is required by default — set auth_token, or explicitly opt out with
# insecure_no_auth (refused unless host is loopback):
# auth_token = "your-bearer-token"      # or set LOPI_WEB_AUTH_TOKEN instead
# insecure_no_auth = true               # only valid with host = "127.0.0.1" / "::1" / "localhost"
# CORS defaults to the local dev origins the web app uses (localhost:5173).
# cors_allowed_origins = ["https://your-dashboard.example.com"]
# cors_permissive = true                # allow any origin — never the default

# ── Scheduled tasks ───────────────────────────────────────────────────────────
# Each [[schedules]] entry fires a task at a cron interval.
# Run `lopi schedules list` to see next run times.
#
# On `lopi sail`, these entries are seeded (once, matched by name) into a
# durable store and can then be managed live via the dashboard / REST API at
# /api/schedules (create, edit, enable/disable, run-now, delete + run history).
# Editing a seeded schedule in the UI takes precedence — the TOML entry is not
# re-applied on the next restart.

# [[schedules]]
# name = "nightly-lint"
# repo = "/Users/wesleyscholl/myrepo"
# goal = "Fix all clippy warnings and formatting issues"
# cron = "0 2 * * *"      # 2am every night (5-field: min hour dom month dow)
# priority = "low"         # low | normal | high | critical

# [[schedules]]
# name = "weekly-deps"
# repo = "/Users/wesleyscholl/myrepo"
# goal = "Update all dependencies to latest compatible versions"
# cron = "0 9 * * MON"    # 9am every Monday
# priority = "normal"

# [[schedules]]
# name = "ci-watchdog"
# repo = "/Users/wesleyscholl/myrepo"
# goal = "Investigate and fix the most recent CI failure"
# cron = "*/30 * * * *"   # Every 30 minutes
# priority = "high"
# allowed_dirs = ["src/", "tests/", ".github/workflows/"]
